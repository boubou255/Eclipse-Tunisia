# SQLite file for local development. For production use a Postgres URL
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Password for /admin. Change it before going live.
ADMIN_PASSWORD="change-me"

# Long random string used to sign the admin session cookie.
ADMIN_SECRET="replace-with-a-long-random-string"

# ─── Konnect online payment (https://konnect.network) ──────────────────────
# Leave KONNECT_API_KEY or KONNECT_WALLET_ID empty to switch online payment off:
# the booking form then sends a request without payment, as before.

# API key from your Konnect dashboard (Settings > API keys).
KONNECT_API_KEY=""

# Your Konnect wallet ID, which receives the payments.
KONNECT_WALLET_ID=""

# "sandbox" for testing, "production" for real payments.
KONNECT_MODE="sandbox"

# Currency charged by Konnect: TND, EUR or USD (your wallet must accept it).
KONNECT_CURRENCY="TND"

# Used only when KONNECT_CURRENCY is TND: tour prices are in euros and converted at this rate.
EUR_TO_TND_RATE="3.40"

# Share paid online when the traveller picks the deposit option.
DEPOSIT_PERCENT="30"

# Public address of the site. Konnect sends travellers back here and calls
# SITE_URL/api/konnect/webhook when a payment changes, so it must be reachable from the internet.
SITE_URL="http://localhost:3000"

# Optional: override the Konnect API address (defaults follow KONNECT_MODE).
# KONNECT_API_URL="https://api.preprod.konnect.network/api/v2"
