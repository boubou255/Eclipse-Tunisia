generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tour {
  id            String            @id @default(cuid())
  slug          String            @unique
  priceEur      Int
  durationDays  Int
  startDate     DateTime
  capacity      Int
  imageUrl      String?
  viewingSite   String
  totality      String
  published     Boolean           @default(false)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  translations  TourTranslation[]
  questions     TourQuestion[]
  bookings      Booking[]
}

/// Content for one language. English is the fallback for missing languages.
model TourTranslation {
  id          String @id @default(cuid())
  tourId      String
  locale      String
  title       String
  summary     String
  description String
  /// One day per block, separated by a blank line. First line is the day title.
  itinerary   String @default("")
  /// One item per line.
  included    String @default("")
  tour        Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
}

/// kind "faq": shown on the tour page with its answer.
/// kind "booking": asked in the booking form; the traveller's answer is saved with the booking.
model TourQuestion {
  id           String                    @id @default(cuid())
  tourId       String
  kind         String                    @default("faq")
  inputType    String                    @default("text")
  required     Boolean                   @default(false)
  sortOrder    Int                       @default(0)
  tour         Tour                      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourQuestionTranslation[]
}

model TourQuestionTranslation {
  id         String       @id @default(cuid())
  questionId String
  locale     String
  question   String
  /// FAQ answer, or comma-separated options for a booking "select" question.
  answer     String       @default("")
  q          TourQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
}

model Booking {
  id         String   @id @default(cuid())
  tourId     String
  name       String
  email      String
  phone      String   @default("")
  country    String   @default("")
  travelers  Int      @default(1)
  message    String   @default("")
  /// JSON array of { question, answer } captured at booking time.
  answers    String   @default("[]")
  locale     String   @default("en")
  status     String   @default("new")
  /// "none" (request only), "deposit" or "full"
  payPlan       String    @default("none")
  /// Tour price x travellers at booking time, in euros.
  totalEur      Int       @default(0)
  /// Sum of completed payments, in euros.
  paidEur       Int       @default(0)
  /// "unpaid", "pending", "deposit_paid", "paid"
  paymentStatus String    @default("unpaid")
  createdAt  DateTime @default(now())
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  payments   Payment[]
}

/// One Konnect checkout. A booking can have several (a failed try, then a retry; a deposit, then the balance).
model Payment {
  id         String   @id @default(cuid())
  bookingId  String
  /// Konnect paymentRef
  ref        String   @unique
  /// "deposit", "full" or "balance"
  kind       String
  amountEur  Int
  /// What Konnect charges: currency token and amount in its smallest unit (millimes for TND, cents for EUR/USD).
  currency   String
  amount     Int
  payUrl     String
  /// "pending", "completed", "failed"
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
